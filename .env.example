# AWS Configuration Template
# Copy this file to .env and fill in actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# RDS Configuration
RDS_ENDPOINT=geography-ai-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=geography_db
RDS_USER=postgres
RDS_PASSWORD=your-strong-password-here

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=https://geography-ai-os.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=geography-documents
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your-strong-password-here

# Model Configuration
MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Retriever URL (for orchestrator to call)
RETRIEVER_AGENT_URL=http://localhost:8081

# S3 Configuration (for ingestion)
S3_BUCKET=geography-ai-docs
S3_PREFIX=documents/

# Service Ports
ORCHESTRATOR_PORT=8002
RETRIEVER_PORT=8081
